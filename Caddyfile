# Use :80 so Caddy doesn't try to generate its own SSL certs
:80 {
    # Enable compression
    encode zstd gzip

    request_body max_size 10MB

    # Route API requests to the backend container
    handle /api/* {
        reverse_proxy backend:3001
    }

    # Route all other requests to the client service
    handle {
        reverse_proxy client:3002
    }
}